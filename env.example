# ==============================================================================
# FIRE FINANCE PRO - PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' on your production server:
# cp .env.example .env
#
# Then modify the values below to match your server environment.
# ==============================================================================

# --- Port Configuration ---
# The host port where the application will be exposed.
# If port 3000 is already in use by another application on your server, 
# you can change this to 3010 or any other available port.
APP_PORT=3010

# --- Database Configuration ---
# Provide either a single connection URI (recommended for cloud providers like Neon/Render)
# Or define separate variables. If none are provided, a secure local JSON database is used.
# DATABASE_URL=postgresql://username:password@localhost:5432/fire_finance
# Or individually:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_secure_postgres_password
# PGDATABASE=fire_finance

# --- Base Application URLs ---
# Leave blank for automatic domain detection from incoming request headers, or set explicitly:
# FRONTEND_URL=https://ffpro.v79sl.duckdns.org
FRONTEND_URL=

# --- Master Encryption & Session Security ---
# Generate a secure random session secret (e.g. using 'openssl rand -base64 32')
SESSION_SECRET=your_secure_random_session_secret_change_me

# 256-bit key used for user-level data encryption (AES-256-GCM).
# Generate via 'openssl rand -base64 32' or 'node -e "console.log(crypto.randomBytes(32).toString(\"base64\"))"'
DATA_ENCRYPTION_KEY=your_secure_32_byte_data_encryption_key_change_me

# --- Gemini AI Integration ---
# Provide your Gemini API key here to enable live AI recommendations and projections.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Funding Finder (grant/funding research) --------------------------------
# Uses the EXISTING Ollama container already running on this server —
# this app never installs, updates, or manages Ollama itself.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Keep this at 1 on small hosts (i5-4590 / 8GB RAM, no GPU) — concurrent
# generations on a 3B model can exhaust RAM quickly.
OLLAMA_MAX_CONCURRENT=1
OLLAMA_REQUEST_TIMEOUT_MS=60000

# Search/fetch layer — discovers candidate funding pages. Get a key at
# https://tavily.com. Without this set, the nightly job runs but finds
# nothing (it fails safe, not hard).
TAVILY_API_KEY=

# Cron schedule (default: 2 AM daily) and safety caps for the research job.
FUNDING_RESEARCH_SCHEDULE=0 2 * * *
FUNDING_RESEARCH_MAX_URLS_PER_RUN=15
FUNDING_RESEARCH_MAX_RUN_MINUTES=45
# Comma-separated override for the discovery search queries. Leave unset to
# use the built-in Caribbean/Saint Lucia business-funding defaults in
# server/services/fundingResearch.js.
FUNDING_SEARCH_QUERIES=

# --- Google OAuth Integration ---
# Configure these in your Google Developer Console (https://console.cloud.google.com)
# Callback URL format: https://yourdomain.com/api/auth/google/callback
# NOTE: login now also requests Gmail read/modify scope with offline access,
# so the resulting refresh token can power Gmail Planning Notifications on
# the dashboard without a separate connect step. This means the OAuth
# consent screen must list the Gmail API scopes (readonly + modify) as
# well as profile/email, and DATA_ENCRYPTION_KEY above must be set since
# the refresh token is stored encrypted per-user in the database.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# --- Meta/Facebook OAuth Integration ---
# Configure these in your Meta Developer Portal (https://developers.facebook.com)
# Callback URL format: https://yourdomain.com/api/auth/facebook/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=/api/auth/facebook/callback

# --- Outgoing Email (project-share invites) ---
# Optional. If not set, invite links are still created and shown/copyable in
# the app (and logged server-side) — they just won't be emailed automatically.
# Any standard SMTP provider works (Gmail app password, SendGrid, Mailgun, your own Postfix, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Fire Finance Pro <no-reply@yourdomain.com>
