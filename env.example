# New installations only: copy to .env and supply real values.
# Existing installs: preserve your .env, encryption key and database volume.
APP_PORT=3010
FRONTEND_URL=https://ffpro.v79sl.com
POSTGRES_USER=ffpro2_user
POSTGRES_DB=fire_finance
# For new databases, generate a URI-safe password with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate a stable session secret with: openssl rand -base64 48
SESSION_SECRET=
# New databases only: openssl rand -base64 32. Never replace an existing data key.
DATA_ENCRYPTION_KEY=
TRUST_PROXY_HOPS=1
# Local Node development uses port 3000 and a development-only JSON store.
# Production outside Docker requires DATABASE_URL and NODE_ENV=production.
# Docker Compose constructs DATABASE_URL from the POSTGRES_* settings above.
DATABASE_URL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MAX_CONCURRENT=1
OLLAMA_REQUEST_TIMEOUT_MS=60000
TAVILY_API_KEY=
FUNDING_RESEARCH_SCHEDULE=0 2 * * *
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=/api/auth/facebook/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
