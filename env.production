# ==============================================================================
# FIRE FINANCE PRO — PRODUCTION .env
# Place this file as `.env` in the SAME directory as docker-compose.yml
# (i.e. ~/FFPRO2/.env on v79sl). Docker Compose reads it automatically.
# ==============================================================================
# Every key docker-compose.yml references must exist here (even if blank) —
# that's what stops the "variable is not set" warnings. Blank is fine for
# anything optional; the app degrades gracefully (falls back to local JSON DB,
# skips OAuth/AI/email features) rather than failing.
# ==============================================================================

# --- Port Configuration ---
# PORT controls which port the Node server listens on inside the container (must match docker-compose ports mapping)

# --- Base Application URL ---
# Automatically detected from incoming request host/domain, or set explicitly below:
FRONTEND_URL=

# --- Master Encryption & Session Security (required — do not leave blank) ---
# Generated for you below. Keep this file private; anyone with these values
# can decrypt stored data and forge sessions.
SESSION_SECRET=bc8c4a9896b87ddce1032005cb2ef896c27b00eca9e2b3e166907085162714cb4f395f74831b17a99f57dc44c5fd694f
DATA_ENCRYPTION_KEY=q9DxeB1TUDjVa0TrWX3qSBqnhfZFVMZJLYVhbr/odzU=

# --- Database Connection ---
# Leave DATABASE_URL blank to let docker-compose build it from POSTGRES_* vars.
# Set POSTGRES_PASSWORD to a strong secret — used by both the postgres
# container and the app's DATABASE_URL connection string.
DATABASE_URL=
POSTGRES_USER=ffpro2_user
POSTGRES_PASSWORD=ffpro2_db_secret_2026
POSTGRES_DB=fire_finance
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- Gemini AI Integration (optional) ---
GEMINI_API_KEY=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=885ce6e231949cde14f74f6f7502441dd34b80f8d8a03a7e6192bbd664611c66
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# --- Meta/Facebook OAuth (optional) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=cd86fd64303ad60ca94a10e631b7d3bd9e63e24cc1cfd624cc2bc831618be509
FACEBOOK_CALLBACK_URL=/api/auth/facebook/callback

# --- Outgoing Email for project-share invites (optional) ---
# Without this, invite links still work — they're shown/copyable in the
# Share modal instead of emailed.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
