# ==============================================================================
# FIRE FINANCE PRO - PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' on your production server:
# cp .env.example .env
#
# Then modify the values below to match your server environment.
# ==============================================================================

# --- Port Configuration ---
# The host port where the application will be exposed.
# If port 3000 is already in use by another application on your server, 
# you can change this to 3010 or any other available port.
APP_PORT=3010

# --- Database Configuration ---
# Provide either a single connection URI (recommended for cloud providers like Neon/Render)
# Or define separate variables. If none are provided, a secure local JSON database is used.
# DATABASE_URL=postgresql://username:password@localhost:5432/fire_finance
# Or individually:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_secure_postgres_password
# PGDATABASE=fire_finance

# --- Base Application URLs ---
# Set this to your server's public IP address or your custom domain name.
FRONTEND_URL=http://199.223.249.193

# --- Master Encryption & Session Security ---
# Generate a secure random session secret (e.g. using 'openssl rand -base64 32')
SESSION_SECRET=your_secure_random_session_secret_change_me

# 256-bit key used for user-level data encryption (AES-256-GCM).
# Generate via 'openssl rand -base64 32' or 'node -e "console.log(crypto.randomBytes(32).toString(\"base64\"))"'
DATA_ENCRYPTION_KEY=your_secure_32_byte_data_encryption_key_change_me

# --- Gemini AI Integration ---
# Provide your Gemini API key here to enable live AI recommendations and projections.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google OAuth Integration ---
# Configure these in your Google Developer Console (https://console.cloud.google.com)
# Callback URL must be configured as: http://199.223.249.193/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://199.223.249.193/api/auth/google/callback

# --- Meta/Facebook OAuth Integration ---
# Configure these in your Meta Developer Portal (https://developers.facebook.com)
# Callback URL must be configured as: http://199.223.249.193/api/auth/facebook/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://199.223.249.193/api/auth/facebook/callback
